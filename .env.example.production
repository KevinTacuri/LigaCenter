# =============================================================================
# LigaCenter - Variables de entorno para Dokploy / Producción
# =============================================================================
# Copia este archivo a `.env` y completa los valores antes de desplegar:
#   cp .env.example.production .env
#
# En Dokploy: configura estas mismas variables en la sección "Environment Variables"
# del servicio Compose (NO subir el .env al repo).
# =============================================================================

# ----------------------------------------------------------------------------
# Aplicación
# ----------------------------------------------------------------------------
APP_NAME=LigaCenter
APP_URL=https://ligacenter.tu-dominio.com

# Genera APP_KEY con: docker run --rm php:8.4-cli php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
# O déjalo vacío en el primer arranque para que entrypoint.sh lo genere automáticamente
APP_KEY=

# ----------------------------------------------------------------------------
# Base de datos
# ----------------------------------------------------------------------------
DB_DATABASE=db_ligacenter
DB_USERNAME=ligacenter
DB_PASSWORD=CAMBIAR_ESTA_PASSWORD_EN_PRODUCCION
DB_ROOT_PASSWORD=CAMBIAR_ESTA_PASSWORD_ROOT_EN_PRODUCCION